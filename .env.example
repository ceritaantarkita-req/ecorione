# Salin ke `.env` dan isi. `.env` di-gitignore dan dipindai secret-scan.
#
# Kredensial provider AI TIDAK disimpan di sini di produksi — hanya modul Connect yang
# memegangnya, terenkripsi at-rest (PRD §14). File ini untuk pengembangan lokal saja.

# Lokasi database memori. Default: ./data/ecorione.db
ECORIONE_DB_PATH=./data/ecorione.db
# Database Hub (audit log + durable state approval) & RnD (trace store) — file terpisah
# dari memori, supaya "no module reaches into another module's DB" tetap benar secara fisik.
ECORIONE_HUB_DB_PATH=./data/hub.db
ECORIONE_RND_DB_PATH=./data/rnd.db

# Endpoint model lokal (Ollama / llama.cpp server), OpenAI-compatible.
ECORIONE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# Model lokal untuk konsolidasi & klasifikasi — bukan untuk agent loop (ADR-04).
# Pin versi eksplisit. Alias `-latest` ditolak (ADR-14). Label harga di
# packages/shared-telemetry/src/pricing.ts: "local/qwen3-8b-instruct-q4_k_m".
ECORIONE_LOCAL_MODEL=qwen3:8b-instruct-q4_K_M
ECORIONE_EMBEDDING_MODEL=

# Provider hosted Fase 1: Anthropic langsung (prompt caching eksplisit lewat cache_control
# — inilah yang membuat klaim prefix-stability ADR-01 bisa diukur nyata). OpenRouter/OpenAI
# disiapkan untuk Fase 2+, kosongkan kalau belum dipakai.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Token bearer internal — memisahkan "proses lain di mesin yang sama" dari "port ini
# kebetulan kebuka", lapis kedua di belakang bind 127.0.0.1 (packages/shared-server).
# Isi dengan string acak sendiri, mis. `openssl rand -hex 24`. Kosong = auth nonaktif
# (hanya untuk dev tanpa .env terisi — jangan kosongkan di pemakaian nyata).
ECORIONE_INTERNAL_TOKEN=

# Port service lokal Fase 1. Semua bind 127.0.0.1 saja (packages/shared-server).
ECORIONE_RND_PORT=17021
ECORIONE_CONTEXT_PORT=17022
ECORIONE_CONNECT_PORT=17023
ECORIONE_HUB_PORT=17024
ECORIONE_RND_URL=http://127.0.0.1:17021
ECORIONE_CONTEXT_URL=http://127.0.0.1:17022
ECORIONE_CONNECT_URL=http://127.0.0.1:17023
ECORIONE_HUB_URL=http://127.0.0.1:17024

# apps/ai (Next.js) — port dev standar, dan URL Hub yang dipanggilnya.
ECORIONE_AI_PORT=3000

# Server MCP lokal (Connect inbound, Fase 2). Bind 127.0.0.1 saja — DNS rebinding
# terhadap server memori lokal akan menyerahkan seluruh riwayat pengguna ke sebuah
# halaman web (PRD §14).
ECORIONE_MCP_HOST=127.0.0.1
ECORIONE_MCP_PORT=17010
