# Salin ke `.env` dan isi. `.env` di-gitignore dan dipindai secret-scan.
# Provider key mentah hanya fallback pengembangan lokal; production/self-host gunakan vault.

# Lokasi database service. Tiap service memiliki DB sendiri.
ECORIONE_DB_PATH=./data/ecorione.db
ECORIONE_HUB_DB_PATH=./data/hub.db
ECORIONE_RND_DB_PATH=./data/rnd.db
ECORIONE_SYNC_DB_PATH=./data/sync.db
ECORIONE_SPACE_DB_PATH=./data/space.db

# Hosted provider eksplisit. Tidak ada auto-router provider/model.
# Pilihan: anthropic | openrouter | openai
ECORIONE_HOSTED_PROVIDER=anthropic

# Local runtime berbasis protokol, bukan vendor. Ollama hanya salah satu implementation.
# Pilihan v1: openai-compatible
ECORIONE_LOCAL_RUNTIME=openai-compatible
# Bisa menunjuk Ollama, llama.cpp server, LM Studio, vLLM, atau runtime lain yang
# mengekspos OpenAI-compatible POST /chat/completions.
ECORIONE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
ECORIONE_LOCAL_MODEL=qwen3:8b-instruct-q4_K_M
ECORIONE_EMBEDDING_MODEL=

# Connect credential vault produksi/self-host. Master key = 32 byte base64url tanpa padding.
# Generate: `pnpm --filter @ecorione/connect vault:keygen`
ECORIONE_CONNECT_VAULT_PATH=./data/connect-credentials.vault.json
ECORIONE_CONNECT_VAULT_MASTER_KEY=

# Provider hosted — fallback dev lokal SAJA dan seluruhnya diabaikan jika vault aktif.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Emergency cost kill switch. Set `1` untuk memblokir semua target hosted di Connect.
ECORIONE_COST_KILL_SWITCH=0

# Durable cumulative hosted spend budget (ADR-21). Kosong = limit periode itu tidak aktif.
ECORIONE_SPEND_BUDGET_PATH=./data/connect-spend-budget.json
ECORIONE_SPEND_DAILY_USD=
ECORIONE_SPEND_MONTHLY_USD=

# Token bearer internal service-to-service.
ECORIONE_INTERNAL_TOKEN=

# Service lokal.
ECORIONE_RND_PORT=17021
ECORIONE_CONTEXT_PORT=17022
ECORIONE_CONNECT_PORT=17023
ECORIONE_HUB_PORT=17024
ECORIONE_ARTIFACT_PORT=17025
ECORIONE_SANDBOX_PORT=17026
ECORIONE_SPACE_PORT=17027
ECORIONE_FLOW_PORT=17028
ECORIONE_RND_URL=http://127.0.0.1:17021
ECORIONE_CONTEXT_URL=http://127.0.0.1:17022
ECORIONE_CONNECT_URL=http://127.0.0.1:17023
ECORIONE_HUB_URL=http://127.0.0.1:17024
ECORIONE_ARTIFACT_URL=http://127.0.0.1:17025
ECORIONE_SANDBOX_URL=http://127.0.0.1:17026
ECORIONE_SPACE_URL=http://127.0.0.1:17027
ECORIONE_FLOW_URL=http://127.0.0.1:17028
ECORIONE_AI_PORT=3000

# Flow durable execution (ADR-17).
ECORIONE_TEMPORAL_ADDRESS=127.0.0.1:7233
ECORIONE_TEMPORAL_NAMESPACE=default

# Artifact CAS L3.
ECORIONE_ARTIFACT_DIR=./data/artifacts

# Sandbox.
ECORIONE_SANDBOX_WORKSPACE_ROOT=./data/workspaces
ECORIONE_SANDBOX_RECEIPT_DIR=./data/sandbox-receipts

# Connect inbound MCP — selalu loopback. Reachability publik lewat Sync + tunnel ADR-16.
ECORIONE_MCP_HOST=127.0.0.1
ECORIONE_MCP_PORT=17010
ECORIONE_MCP_URL=http://127.0.0.1:17010
ECORIONE_MCP_OAUTH_ISSUER=
ECORIONE_MCP_RESOURCE=
ECORIONE_MCP_JWKS_URL=
ECORIONE_MCP_HANDLE_KEY=
ECORIONE_MCP_SCOPES=personal
ECORIONE_MCP_MAX_SENSITIVITY=INTERNAL
ECORIONE_MCP_ALLOWED_ORIGINS=

# Connect outbound MCP manager (ADR-23).
ECORIONE_MCP_OUTBOUND_REGISTRY_PATH=./data/connect-mcp-registry.json
ECORIONE_MCP_OUTBOUND_INVOCATION_PATH=./data/connect-mcp-invocations.json
# Comma-separated exact command strings. Kosong = seluruh stdio outbound ditolak.
ECORIONE_MCP_STDIO_ALLOWLIST=

# Sync local/self-hosted.
ECORIONE_SYNC_PORT=17011
ECORIONE_SYNC_OWNER_TOKEN=
