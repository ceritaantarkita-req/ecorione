# Salin ke `.env` dan isi. `.env` di-gitignore dan dipindai secret-scan.
#
# Kredensial provider AI TIDAK disimpan di sini di produksi — hanya modul Connect yang
# memegangnya, terenkripsi at-rest (PRD §14). File ini untuk pengembangan lokal saja.

# Lokasi database service. Tiap service memiliki DB sendiri; tidak ada service yang
# membuka DB service lain secara langsung.
ECORIONE_DB_PATH=./data/ecorione.db
ECORIONE_HUB_DB_PATH=./data/hub.db
ECORIONE_RND_DB_PATH=./data/rnd.db
ECORIONE_SYNC_DB_PATH=./data/sync.db
ECORIONE_SPACE_DB_PATH=./data/space.db

# Endpoint model lokal (Ollama / llama.cpp server), OpenAI-compatible.
ECORIONE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# Model lokal untuk konsolidasi & klasifikasi — bukan untuk agent loop (ADR-04).
ECORIONE_LOCAL_MODEL=qwen3:8b-instruct-q4_K_M
ECORIONE_EMBEDDING_MODEL=

# Provider hosted.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Token bearer internal service-to-service. Isi dengan string acak sendiri.
ECORIONE_INTERNAL_TOKEN=

# Service lokal.
ECORIONE_RND_PORT=17021
ECORIONE_CONTEXT_PORT=17022
ECORIONE_CONNECT_PORT=17023
ECORIONE_HUB_PORT=17024
ECORIONE_ARTIFACT_PORT=17025
ECORIONE_SANDBOX_PORT=17026
ECORIONE_SPACE_PORT=17027
ECORIONE_RND_URL=http://127.0.0.1:17021
ECORIONE_CONTEXT_URL=http://127.0.0.1:17022
ECORIONE_CONNECT_URL=http://127.0.0.1:17023
ECORIONE_HUB_URL=http://127.0.0.1:17024
ECORIONE_ARTIFACT_URL=http://127.0.0.1:17025
ECORIONE_SANDBOX_URL=http://127.0.0.1:17026
ECORIONE_SPACE_URL=http://127.0.0.1:17027
ECORIONE_AI_PORT=3000

# Artifact CAS L3. Blob fisik didedup berdasarkan SHA-256; metadata/otorisasi tetap di
# Context melalui API service boundary.
ECORIONE_ARTIFACT_DIR=./data/artifacts

# Sandbox. Tier 0 selalu guard; Tier 1.5 WASM tanpa host import; Tier 1 Docker hardened.
# Workspace yang boleh dieksekusi harus berada di bawah root ini.
ECORIONE_SANDBOX_WORKSPACE_ROOT=./data/workspaces
ECORIONE_SANDBOX_RECEIPT_DIR=./data/sandbox-receipts

# Connect inbound MCP — selalu loopback. Reachability publik hanya lewat Sync + tunnel
# yang dipilih ADR-16, tidak dengan membind Connect ke 0.0.0.0.
ECORIONE_MCP_HOST=127.0.0.1
ECORIONE_MCP_PORT=17010
ECORIONE_MCP_URL=http://127.0.0.1:17010
ECORIONE_MCP_OAUTH_ISSUER=
ECORIONE_MCP_RESOURCE=
ECORIONE_MCP_JWKS_URL=
# 32 byte base64url, contoh generate lokal: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
ECORIONE_MCP_HANDLE_KEY=
ECORIONE_MCP_SCOPES=personal
ECORIONE_MCP_MAX_SENSITIVITY=INTERNAL
ECORIONE_MCP_ALLOWED_ORIGINS=

# Sync local/self-hosted. Owner token hanya untuk bootstrap device pertama; device lain
# masuk lewat pairing code sekali pakai. Managed public relay tidak berada di repo ini.
ECORIONE_SYNC_PORT=17011
ECORIONE_SYNC_OWNER_TOKEN=
