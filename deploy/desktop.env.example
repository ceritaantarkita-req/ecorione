# ECORIONE desktop/local launcher environment (non-secret defaults only).
# The Windows launcher copies this file to desktop.env and adds required local secrets at install/start time.

ECORIONE_IMAGE=ecorione:local
ECORIONE_LOCAL_RUNTIME=openai-compatible
ECORIONE_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
ECORIONE_LOCAL_MODEL=qwen3:8b-instruct-q4_K_M
ECORIONE_HOSTED_PROVIDER=anthropic
ECORIONE_COST_KILL_SWITCH=1
ECORIONE_AI_PORT=3000
