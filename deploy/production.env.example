# Copy to deploy/production.env (gitignored) and replace every CHANGE_ME value.
ECORIONE_IMAGE_TAG=local
ECORIONE_DOMAIN=ecorione.example.com
ECORIONE_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN
ECORIONE_SYNC_OWNER_TOKEN=CHANGE_ME_LONG_RANDOM_SYNC_OWNER_TOKEN
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=CHANGE_ME_TEMPORAL_DB_PASSWORD

# Generate with: caddy hash-password --plaintext 'your-long-password'
ECORIONE_OPS_USER=operator
ECORIONE_OPS_PASSWORD_HASH=CHANGE_ME_CADDY_PASSWORD_HASH

# Provider/runtime. Production hosted credentials belong in Connect Vault, not this file.
ECORIONE_HOSTED_PROVIDER=anthropic
ECORIONE_LOCAL_RUNTIME=openai-compatible
ECORIONE_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
ECORIONE_LOCAL_MODEL=qwen3:8b-instruct-q4_K_M
ECORIONE_CONNECT_VAULT_MASTER_KEY=CHANGE_ME_BASE64URL_32_BYTE_MASTER_KEY
# Runtime provider/model changes from Control Center persist under Connect's owner volume.
ECORIONE_SPEND_DAILY_USD=5
ECORIONE_SPEND_MONTHLY_USD=100
ECORIONE_COST_KILL_SWITCH=0
ECORIONE_MCP_STDIO_ALLOWLIST=

# Existing OAuth/OIDC resource-server values for public MCP.
ECORIONE_MCP_OAUTH_ISSUER=https://auth.example.com/
ECORIONE_MCP_RESOURCE=https://ecorione.example.com/mcp
ECORIONE_MCP_JWKS_URL=https://auth.example.com/.well-known/jwks.json
ECORIONE_MCP_HANDLE_KEY=CHANGE_ME_RANDOM_HANDLE_KEY
ECORIONE_MCP_ALLOWED_ORIGINS=https://chatgpt.com
