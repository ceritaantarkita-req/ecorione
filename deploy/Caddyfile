{$ECORIONE_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(self), geolocation=()"
  }

  # Public event ingress is intentionally outside the browser Basic-Auth gate.
  # Ai only proxies the bounded request; Connect still owns the per-hook token check.
  handle_path /webhooks/* {
    request_body {
      max_size 96KB
    }
    rewrite * /api/webhooks{path}
    reverse_proxy ai:3000
  }

  @operator path /ops* /api/ops* /settings* /api/settings*
  handle @operator {
    basic_auth {
      {$ECORIONE_OPS_USER} {$ECORIONE_OPS_PASSWORD_HASH}
    }
    reverse_proxy ai:3000
  }

  handle /.well-known/oauth-protected-resource* {
    reverse_proxy sync:17011
  }

  handle /mcp* {
    reverse_proxy sync:17011
  }

  # Bootstrap browser Basic Auth without exposing the Ai root. The installed
  # staging deploy gate historically waits for a 2xx/3xx home response, so an
  # unauthenticated root is redirected to a protected login challenge. After the
  # browser caches valid Basic credentials, /login redirects back to / and the
  # authenticated root is served by the private fallback below.
  @unauthenticated_root {
    path /
    not header Authorization *
  }
  redir @unauthenticated_root /login 302

  handle /login {
    basic_auth {
      {$ECORIONE_OPS_USER} {$ECORIONE_OPS_PASSWORD_HASH}
    }
    redir / 302
  }

  # Private-by-default browser/app surface. Reuse the existing operator credential
  # so staging can be closed immediately without introducing a second secret set.
  handle {
    basic_auth {
      {$ECORIONE_OPS_USER} {$ECORIONE_OPS_PASSWORD_HASH}
    }
    reverse_proxy ai:3000
  }
}
