{
  "name": "@ecorione/connect",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "mcp:stdio": "tsx src/mcp/stdio-main.ts",
    "mcp:http": "tsx src/mcp/http-main.ts",
    "vault:keygen": "tsx src/vault-cli.ts keygen",
    "vault:list": "tsx src/vault-cli.ts list",
    "vault:set": "tsx src/vault-cli.ts set",
    "vault:rotate-master": "tsx src/vault-cli.ts rotate-master"
  },
  "dependencies": {
    "@ecorione/context-assembly": "workspace:*",
    "@ecorione/shared-schema": "workspace:*",
    "@ecorione/shared-server": "workspace:*",
    "@ecorione/shared-telemetry": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^4.1.12"
  }
}
