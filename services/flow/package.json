    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@temporalio/testing": "1.23.0",
    "@types/better-sqlite3": "^7.6.13"
  }
